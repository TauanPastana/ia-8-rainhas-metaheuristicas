      "parameters": {
        "jsCode": "const f = $json.body ?? $json.data ?? $json;\nlet cmd = 'cd /home/node/.n8n-files && python3 metaheuristica.py';\ncmd += ` --execucoes ${Number(f.execucoes ?? 50)}`;\ncmd += ` --iteracoes-grasp ${Number(f.iteracoes_grasp ?? 200)}`;\ncmd += ` --tamanho-rcl ${Number(f.tamanho_rcl ?? 3)}`;\ncmd += ` --populacao ${Number(f.populacao ?? 20)}`;\ncmd += ` --taxa-cruzamento ${Number(f.taxa_cruzamento ?? 0.8)}`;\ncmd += ` --taxa-mutacao ${Number(f.taxa_mutacao ?? 0.03)}`;\ncmd += ` --max-geracoes ${Number(f.max_geracoes ?? 1000)}`;\nreturn [{ json: { ...f, comando: cmd } }];"
      },
