        "jsCode": "const f = $input.first().json;\n\nlet resumoPython = null;\ntry {\n  resumoPython = JSON.parse((f.stdout || '').trim());\n} catch (e) {\n  resumoPython = f.stdout || '';\n}\n\nreturn [{\n  json: {\n    sucesso: f.exitCode === 0,\n    exitCode: f.exitCode,\n    parametros: {\n      execucoes: f.execucoes ?? null,\n      iteracoes_grasp: f.iteracoes_grasp ?? null,\n      tamanho_rcl: f.tamanho_rcl ?? null,\n      populacao: f.populacao ?? null,\n      taxa_cruzamento: f.taxa_cruzamento ?? null,\n      taxa_mutacao: f.taxa_mutacao ?? null,\n      max_geracoes: f.max_geracoes ?? null\n    },\n    saida_python: resumoPython,\n    stdout: f.stdout ?? '',\n    stderr: f.stderr ?? ''\n  }\n}];"
      },
